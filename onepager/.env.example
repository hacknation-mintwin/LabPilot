##
## Optional: Semantic Scholar API key (raises rate limits).
## If you have one, paste it here.
##
S2_API_KEY=

##
## Required: contact email for User-Agent headers
## (used for all upstream requests to be polite with rate limits).
##
CONTACT_EMAIL=you@example.com

##
## Required for /plan: OpenRouter API key for LLM calls.
## Get one at https://openrouter.ai/keys
##
OPENROUTER_API_KEY=

##
## Optional: model overrides (defaults shown).
## PLAN_MODEL is used for plan generation (needs strong reasoning + JSON);
## FAST_MODEL is used for cheap frame extraction.
##
# PLAN_MODEL=anthropic/claude-3.5-sonnet
# FAST_MODEL=google/gemini-2.0-flash-001
