##
## Optional: Semantic Scholar API key (raises rate limits).
##
S2_API_KEY=

##
## Recommended: contact email for User-Agent headers
## (used for upstream requests to be polite with rate limits).
##
CONTACT_EMAIL=you@example.com

##
## Required for /plan: at least ONE of the LLM provider keys below must be set.
## /plan walks the providers in this priority order until one succeeds:
##   1. PRIMARY    : Gemini 2.5 Flash       (Google AI Studio)
##   2. FALLBACK 1 : Gemini 2.5 Flash-Lite  (Google AI Studio, same key)
##   3. FALLBACK 2 : Llama 3.3 70B          (Groq)
##   4. FALLBACK 3 : Llama 3.3 70B          (Cerebras)
##

# Google AI Studio (covers PRIMARY and FALLBACK 1)
GEMINI_API_KEY=

# Groq (FALLBACK 2)
GROQ_API_KEY=

# Cerebras (FALLBACK 3)
CEREBRAS_API_KEY=
